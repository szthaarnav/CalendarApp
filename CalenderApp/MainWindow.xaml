<Window x:Class="CalenderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendar Manager" Height="450" Width="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Row 0: Filter Controls -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Action Buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: DataGrid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The new Filter UI -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker SelectedDate="{Binding StartDate}" Width="120" Margin="0,0,15,0"/>

            <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker SelectedDate="{Binding EndDate}" Width="120" Margin="0,0,15,0"/>

            <Button Content="Filter" Width="80" Command="{Binding FilterCommand}" Margin="0,0,10,0"/>
            <Button Content="Clear" Width="80" Command="{Binding ClearFilterCommand}"/>
        </StackPanel>

        <!-- Your existing Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Add New Entry" Width="120" Margin="0,0,10,0" Command="{Binding AddCommand}"/>
            <Button Content="Edit Selected" Width="120" Margin="0,0,10,0" Command="{Binding EditCommand}"/>
            <Button Content="Delete Selected" Width="120" Command="{Binding DeleteCommand}"/>
        </StackPanel>

        <!-- Your existing DataGrid -->
        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding Entries}" 
                  SelectedItem="{Binding SelectedEntry}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding EventDate, StringFormat=d}" Width="100"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="200"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>